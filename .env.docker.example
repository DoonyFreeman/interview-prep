# Copy to .env (repo root) before `docker compose up`.
# The single-image deployment serves the SPA and the API from one origin, so the
# frontend uses a relative `/api` base and CORS is not needed for normal use.

# --- Auth ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-please
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080  # 7 days

# --- LLM (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-2.5-flash,gemini-flash-lite-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- App ---
# DATABASE_URL and CONTENT_DIR default to in-image paths (see Dockerfile);
# override only if you know what you're doing. Same-origin serving means CORS is
# usually irrelevant, but set this if you front the API from another origin.
CORS_ORIGINS=
