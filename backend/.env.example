# --- Database ---
# Async SQLite (file lives in backend/data/). WAL mode enabled in code.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- Auth ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-please
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080  # 7 days

# --- LLM (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Ordered fallbacks tried on per-day quota / transient errors (comma-separated).
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-2.5-flash,gemini-flash-lite-latest
# Optional proxy/base override (e.g. Cloudflare Worker), default is Google's endpoint
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- App ---
# Comma-separated origins allowed by CORS (frontend dev server)
CORS_ORIGINS=http://localhost:5173
# Absolute or relative path to the content directory (markdown + seed)
CONTENT_DIR=../content
